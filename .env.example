# Clé API Resend (https://resend.com) — nécessaire pour l'envoi d'email du formulaire de contact.
# 1. Crée un compte gratuit sur resend.com
# 2. Génère une API key (Dashboard > API Keys)
# 3. Colle-la ici en local (.env.local) et dans Vercel (Settings > Environment Variables)
RESEND_API_KEY=

# Adresse qui recevra les demandes de devis (par défaut: africanbusinesstrade@gmail.com)
CONTACT_TO_EMAIL=africanbusinesstrade@gmail.com

# Adresse d'expédition. Tant que ton domaine n'est pas vérifié sur Resend,
# laisse "onboarding@resend.dev" — ça fonctionne pour les tests.
# Une fois ton nom de domaine choisi et branché sur Vercel, vérifie-le sur
# Resend et remplace par ex. "ABT <contact@ton-domaine.com>"
CONTACT_FROM_EMAIL=ABT Site <onboarding@resend.dev>
